{
  "crons": [
    {
      "path": "/api/refresh-data",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/smart-update",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "app/api/refresh-data/route.ts": {
      "maxDuration": 300
    },
    "app/api/smart-update/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/daily-refresh/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/trigger/route.ts": {
      "maxDuration": 300
    }
  }
}
